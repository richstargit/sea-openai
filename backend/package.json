{
  "name": "sea-openai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Main API for sea-openai",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "errorhandler": "^1.5.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.2.0",
    "morgan": "^1.12.1",
    "response-time": "^2.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
