{
  "name": "sea-openai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Main API for sea-openai",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "jest",
    "test:agent-mongo": "npm run build && node --test tests/agent-thread.integration.mjs",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@langchain/core": "^1.5.0",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-mongodb": "^1.5.2",
    "@mediabunny/server": "^1.66.2",
    "@napi-rs/canvas": "^1.2.0",
    "body-parser": "^2.3.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "errorhandler": "^1.5.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "helmet": "^8.2.0",
    "ipaddr.js": "^2.5.0",
    "mediabunny": "^1.66.2",
    "mongodb": "^6.22.0",
    "mongoose": "^8.24.10",
    "morgan": "^1.12.1",
    "openai": "^7.62.0",
    "playwright-core": "^1.65.1",
    "response-time": "^2.3.4",
    "undici": "^7.30.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "mongoose": {
      "mongodb": "$mongodb"
    }
  }
}
